<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Nullable was enabled but nothing stopped a warning accumulating. The bug that prompted
         this: ListCachePerTenant.Get() returned a `volatile List<T>?` field through a non-nullable
         return type, and flow analysis let it past because the null check and the return were
         separated by a lock and a delegate call. Measured 2026-08-27 before turning it on: the
         build had ZERO nullable warnings, so this cost nothing to adopt and exists to keep it
         that way.

         CS8600 has to be excluded HERE, not just in .editorconfig: measured, `nullable` in
         WarningsAsErrors overrides an editorconfig `severity = none` and promotes it anyway
         (223 errors on a clean build). See .editorconfig for why those 446 sites stand. -->
    <WarningsAsErrors>nullable</WarningsAsErrors>
    <WarningsNotAsErrors>CS8600</WarningsNotAsErrors>
    <BaseOutputPath></BaseOutputPath>
    <AssemblyName>UiPathOrch</AssemblyName>
    <Version>1.15.1</Version>
    <GenerateDocumentationFile>False</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="bot\autopilot.png" />
    <EmbeddedResource Include="bot\caring.png" />
    <EmbeddedResource Include="bot\flying.png" />
    <EmbeddedResource Include="bot\listening.png" />
    <EmbeddedResource Include="bot\processing.png" />
    <EmbeddedResource Include="bot\receiving.png" />
    <EmbeddedResource Include="bot\recording.png" />
    <EmbeddedResource Include="bot\searching.png" />
    <!-- Known-endpoint catalog for Invoke-OrchApi -Uri completion.
         Generated from the swagger corpus by Tools\Update-ApiEndpointCatalog.ps1. -->
    <EmbeddedResource Include="Resources\ApiEndpoints.txt" />
    <EmbeddedResource Include="Resources\de\MountSuccessNotification.html" />
    <EmbeddedResource Include="Resources\en\MountSuccessNotification.html" />
    <EmbeddedResource Include="Resources\fr\MountSuccessNotification.html" />
    <EmbeddedResource Include="Resources\ja\MountSuccessNotification.html" />
    <EmbeddedResource Include="Resources\ko\MountSuccessNotification.html" />
    <EmbeddedResource Include="Resources\ro\MountSuccessNotification.html" />
    <EmbeddedResource Include="Resources\tr\MountSuccessNotification.html" />
    <EmbeddedResource Include="Resources\de\EntraAdvisory.txt" />
    <EmbeddedResource Include="Resources\en\EntraAdvisory.txt" />
    <EmbeddedResource Include="Resources\fr\EntraAdvisory.txt" />
    <EmbeddedResource Include="Resources\ja\EntraAdvisory.txt" />
    <EmbeddedResource Include="Resources\ko\EntraAdvisory.txt" />
    <EmbeddedResource Include="Resources\ro\EntraAdvisory.txt" />
    <EmbeddedResource Include="Resources\tr\EntraAdvisory.txt" />
    <EmbeddedResource Include="Resources\de\UiPathOrchConfig.json" />
    <EmbeddedResource Include="Resources\en\UiPathOrchConfig.json" />
    <EmbeddedResource Include="Resources\fr\UiPathOrchConfig.json" />
